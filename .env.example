VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_GOOGLE_BOOKS_API_KEY=

# --- B.IA (modelo de linguagem) ---
# ATENCAO: sem o prefixo VITE_. Variaveis VITE_ sao embutidas no bundle publico;
# esta precisa ficar so no servidor. Configure no painel do Vercel:
# Settings > Environment Variables.
# Gere a chave (gratuita) em https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Id do projeto Firebase, usado pela funcao para validar o token de quem chama.
# O /api/bia recusa requisicao sem login — sem isso qualquer um descobriria a
# URL e esgotaria a cota gratuita. Mesmo valor de VITE_FIREBASE_PROJECT_ID,
# mas sem o prefixo: e usado no servidor.
FIREBASE_PROJECT_ID=

# Opcional. Gemma e Gemini usam a mesma chave — trocar de modelo e trocar esta
# variavel. Padrao: gemini-3.5-flash-lite (2,5s e ~508 tokens por mensagem).
# Medidos com o mesmo prompt: gemini-3.1-flash-lite 1,8s | gemini-3.6-flash
# 8,9s e ~1931 tokens (raciocinio pesado) | gemma-4-31b-it 23,8s.
# NAO use gemini-2.5-flash: foi descontinuado para chaves novas (404).
# Para listar os modelos que SUA chave libera:
#   curl "https://generativelanguage.googleapis.com/v1beta/models?key=SUA_CHAVE"
BIA_MODEL=
